generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  FREELANCER
}

enum Availability {
  AVAILABLE
  PART_TIME
  BUSY
}

enum JobStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  role            Role      @default(CLIENT)
  avatarHue       Int       @default(220)

  title           String?
  bio             String?
  category        String?
  skills          String[]  @default([])
  hourlyRate      Float?
  experienceYears Float?
  location        String?
  availability    Availability @default(AVAILABLE)
  remote          String?
  website         String?
  github          String?
  linkedin        String?
  verified        Boolean   @default(false)
  featured        Boolean   @default(false)
  completedJobs   Int       @default(0)
  rating          Float?

  createdAt       DateTime  @default(now())
  jobs            Job[]     @relation("jobOwner")
  applications    Application[]
  requestsSent    ProjectRequest[] @relation("requestsSent")
  requestsReceived ProjectRequest[] @relation("requestsReceived")
}

model Job {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation("jobOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String
  category    String
  skills      String[] @default([])
  budgetMin   Float
  budgetMax   Float?
  duration    String?
  location    String?
  remote      Boolean  @default(true)
  status      JobStatus @default(OPEN)
  createdAt   DateTime @default(now())
  applications Application[]
}

model Application {
  id           String  @id @default(cuid())
  jobId        String
  job          Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancerId String
  freelancer   User    @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  coverLetter  String
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime @default(now())

  @@unique([jobId, freelancerId])
}

model ProjectRequest {
  id           String  @id @default(cuid())
  clientId     String
  client       User    @relation("requestsSent", fields: [clientId], references: [id], onDelete: Cascade)
  freelancerId String
  freelancer   User    @relation("requestsReceived", fields: [freelancerId], references: [id], onDelete: Cascade)
  title        String
  description  String
  budget       Float?
  status       RequestStatus @default(PENDING)
  createdAt    DateTime @default(now())
}